# UHI Infrastructure Environment Variables
# Copy this file to .env before running docker-compose

# Orion-LD Context Broker
ORION_URL=http://localhost:1026

# UrbIS Orthophoto URLs (Brussels 2024)
RGB_URL=https://urbisdownload.datastore.brussels/UrbIS/Grid/Ortho/Ortho2024EO/TIFF/Ortho_31370_TIFF_04000_20240920_40_RGB.zip
NIR_URL=https://urbisdownload.datastore.brussels/UrbIS/Grid/Ortho/Ortho2024EO/TIFF/Ortho_31370_TIFF_04000_20240920_40_NIR.zip
DTM_URL=https://geoservices-urbis.irisnet.be/geoserver/urbisgrid/wcs
BUILDINGS_AND_ENGINEERING_WORKS_URL=https://urbisdownload.datastore.brussels/UrbIS/Vector/M8/UrbIS-Buildings3D/GPKG/UrbISBuildings3D_31370_GPKG_04000_20260207.zip

# Data Paths
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed

# Service Ports
INGESTION_PORT=8001
PREDICTION_PORT=8002
GEOSERVER_PORT=8080



