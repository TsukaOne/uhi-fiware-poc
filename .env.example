# Configuration example — copy this file to .env and fill in the values

# Cesium ion token (terrain + geocoder), injected into the frontend at build time
VITE_CESIUM_ION_TOKEN=CHANGE_ME

# CARTO basemap key — used by nginx (and Vite in dev) only, never sent to the browser
CARTO_API_KEY=CHANGE_ME

# Public domain and Let's Encrypt contact for Caddy (HTTPS)
DOMAIN=uhi.example.com
TLS_EMAIL=you@example.com
